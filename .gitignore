# Java / Maven
target/
*.class
*.jar
*.war

# Node
node_modules/

# Playwright
# Sin barra inicial ni interna, para que apliquen a cualquier profundidad.
# (Un patron como "playwright/test-results/" solo cubriria esa ruta exacta;
# si manana la carpeta se anida un nivel mas, dejaria de aplicar.)
test-results/
playwright-report/
blob-report/
.playwright/

# Las capturas de referencia SI se versionan: son la linea base contra la que
# se compara. Lo que no se versiona es el resultado de cada corrida.
!**/*-snapshots/

# Modulo 6 (probar con IA)
# Los reportes son el resultado de cada corrida: se regeneran, no se versionan.
# Con **/ porque un patron con barra interna solo aplicaria desde la raiz.
**/ia/reportes/
ia-resultados.json
# init-agents de Playwright genera este archivo con comandos de SU sistema
# operativo (en Windows, "cmd"): subirlo rompe el de sus companeros.
.mcp.json

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
__pycache__/
